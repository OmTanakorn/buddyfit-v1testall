# Copy this file to .env and fill in your values
# Never commit .env to version control

# Django
SECRET_KEY=your-secret-key-here-generate-with-python-c-"import-secrets;print(secrets.token_urlsafe(50))"
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Set to "production" to enforce SECRET_KEY requirement
DJANGO_ENV=development

# Database (leave blank to use SQLite in development)
# DB_NAME=buddyfit
# DB_USER=postgres
# DB_PASSWORD=your-db-password
# DB_HOST=db
# DB_PORT=5432

# CORS (production only, comma-separated)
# CORS_ALLOWED_ORIGINS=https://buddyfit.example.com
